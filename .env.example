# Скопируй в .env и заполни. .env НЕ коммитить.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=krakow_di
POSTGRES_USER=krakow
POSTGRES_PASSWORD=change_me

# Kafka (внутренний доступ для наших сервисов)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=krakow
# Внешний listener для других команд (заполняется при развёртывании)
KAFKA_EXTERNAL_HOST=
KAFKA_EXTERNAL_PORT=9094
# read-only пользователь для других команд (SASL/SCRAM-SHA-512)
KAFKA_TEAMS_USER=teams
KAFKA_TEAMS_PASSWORD=change_me

# Источники
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKET=sk

# Генератор
GENERATOR_TICK_SECONDS=300
GENERATOR_SEED=
GENERATOR_TIME_SPEEDUP=1

# Идентификатор в событиях
PRODUCER_ID=tuke-di-krakow
