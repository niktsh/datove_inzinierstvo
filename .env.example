# Skopírovať do .env a doplniť. .env NECOMMITOVAŤ.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=krakow_di
POSTGRES_USER=krakow
POSTGRES_PASSWORD=change_me

# Kafka (interný prístup pre naše služby)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=krakow
# Externý listener pre ostatné tímy (SASL_SSL); verejné meno servera je nižšie v sekcii nasadenia
KAFKA_EXTERNAL_PORT=9094
# používateľ iba na čítanie pre ostatné tímy (SASL/SCRAM-SHA-512)
KAFKA_TEAMS_USER=teams
KAFKA_TEAMS_PASSWORD=change_me

# Zdroje
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKET=sk

# Generátor
GENERATOR_TICK_SECONDS=300
GENERATOR_SEED=
GENERATOR_TIME_SPEEDUP=1
# pravdepodobnosť predaja na 5-minútový tik pre priemernú ponuku (škáluje celkový objem)
GENERATOR_BASE_RATE=0.004
# rozptyl „popularity“ ponúk (väčší = nerovnomernejší predaj)
GENERATOR_POPULARITY_SIGMA=1.0
# Generátor divadla: pravdepodobnosť simulovaného predaja jedného predstavenia na 5-minútový tik
GENERATOR_THEATER_BASE_RATE=0.005

# Plánovač: intervaly behov v hodinách (generátor beží každých GENERATOR_TICK_SECONDS)
SCHEDULER_TRAVELPAYOUTS_HOURS=6
SCHEDULER_RYANAIR_HOURS=12
SCHEDULER_THEATER_PROGRAMME_HOURS=24
SCHEDULER_THEATER_SNAPSHOTS_HOURS=3

# Identifikátor v udalostiach
PRODUCER_ID=tuke-di-krakow

# --- Produkčné nasadenie (docker-compose.prod.yml, pozri docs/NASADENIE.md) ---
# verejné meno servera; Kafka ho ohlasuje ostatným tímom (advertised.listeners)
KAFKA_EXTERNAL_HOST=kafka.example.org
# heslo ku keystore (scripts/gen_kafka_tls.sh)
KAFKA_SSL_PASSWORD=change_me
# doména pre HTTPS API (Caddy si certifikát vybaví sám); ':80' = iba HTTP
API_DOMAIN=:80
# koľko dní držať denné zálohy DB
BACKUP_KEEP_DAYS=14
