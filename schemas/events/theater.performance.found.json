{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krakow-di.local/schemas/events/theater.performance.found.json",
  "title": "theater.performance.found",
  "description": "Nové predstavenie v programe",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "theater.performance.found"
    },
    "event_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "theater"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "performance_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "starts_at": {
          "type": "string",
          "format": "date-time"
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "on_sale",
            "sold_out",
            "cancelled",
            "past"
          ]
        }
      },
      "required": [
        "performance_id",
        "title",
        "stage",
        "starts_at",
        "url",
        "status"
      ]
    }
  },
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "producer",
    "source",
    "data"
  ]
}
