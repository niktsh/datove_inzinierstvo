{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krakow-di.local/schemas/events/flight.offer.sold_out.json",
  "title": "flight.offer.sold_out",
  "description": "Ponuka je vypredaná",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "const": "flight.offer.sold_out"
    },
    "event_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "generator"
      ]
    },
    "data": {
      "type": "object",
      "properties": {
        "offer_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "last_price": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "offer_id",
        "last_price",
        "currency"
      ]
    }
  },
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "producer",
    "source",
    "data"
  ]
}
